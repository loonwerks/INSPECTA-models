-- A minimal HAMR/Microkit example whose consumer invokes an R2U2 monitor.
package Component_Monitor
public
  with Base_Types;
  with CASE_Scheduling;
  with HAMR;

  system Sys
  end Sys;

  system implementation Sys.i
    subcomponents
      producer : process ProducerProc.i;
      consumer : process ConsumerProc.i;
      cpu      : processor MicrokitProcor;
    connections
      samples : port producer.sample -> consumer.sample;
    properties
      Actual_Processor_Binding => (reference (cpu)) applies to producer, consumer;
  end Sys.i;

  processor MicrokitProcor
    properties
      Frame_Period => 1000 ms;
      Clock_Period => 1 ms;
  end MicrokitProcor;

  process ProducerProc
    features
      sample : out event data port Base_Types::Integer_32;
  end ProducerProc;

  process implementation ProducerProc.i
    subcomponents
      producer : thread ProducerThr.i;
    connections
      sample_connection : port producer.sample -> sample;
    properties
      CASE_Scheduling::Domain => 2;
      HAMR::Microkit_Language => Rust;
  end ProducerProc.i;

  thread ProducerThr
    features
      sample : out event data port Base_Types::Integer_32;
  end ProducerThr;

  thread implementation ProducerThr.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
      Compute_Execution_Time => 10 ms .. 10 ms;
  end ProducerThr.i;

  process ConsumerProc
    features
      sample : in event data port Base_Types::Integer_32;
  end ConsumerProc;

  process implementation ConsumerProc.i
    subcomponents
      consumer : thread ConsumerThr.i;
    connections
      sample_connection : port sample -> consumer.sample;
    properties
      CASE_Scheduling::Domain => 3;
      HAMR::Microkit_Language => Rust;
  end ConsumerProc.i;

  thread ConsumerThr
    features
      sample : in event data port Base_Types::Integer_32;

    -- HAMR translates this monitor guarantee to a C2PO specification and
    -- invokes R2U2 from the generated consumer component on every dispatch.
    annex GUMBO {**
      monitor
        guarantee sample_arrives "A sample arrives now or within the next two dispatches":
          Eventually[0,2] (HasEvent(sample));
    **};
  end ConsumerThr;

  thread implementation ConsumerThr.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
      Compute_Execution_Time => 10 ms .. 10 ms;
  end ConsumerThr.i;
end Component_Monitor;
