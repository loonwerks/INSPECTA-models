-- Do not edit this file as it will be overwritten if HAMR codegen is rerun

ENUM
	OperatingState: {Idle: 0, Active: 1, Fault: 2};

STRUCT
	Telemetry_i: { sequence_number: int; valid: bool; operating_state: OperatingState; values: int[]; };

INPUT
	api_pulse_nonEmpty: bool;
	api_sample_nonEmpty: bool;
	api_sample: int;
	api_level: int;
	api_boolean_value: bool;
	api_character_value: int;
	api_signed_8_value: int;
	api_signed_16_value: int;
	api_unsigned_8_value: int;
	api_unsigned_16_value: int;
	api_flag_nonEmpty: bool;
	api_flag: bool;
	api_ack_nonEmpty: bool;
	api_echo_nonEmpty: bool;
	api_ack_isEmpty: bool;
	api_echo_isEmpty: bool;
	api_echo: int;
	api_healthy: bool;
	api_operating_state_nonEmpty: bool;
	api_operating_state: OperatingState;
	api_samples_nonEmpty: bool;
	api_samples_size: int;
	api_samples: int[4];
	api_telemetry_nonEmpty: bool;
	api_telemetry_sequence_number: int;
	api_telemetry_valid: bool;
	api_telemetry_operating_state: OperatingState;
	api_telemetry_values: int[4];
	sprevious_level: int;
	in_sprevious_level: int;
	fn_isNonNegative_level: bool;
	fn_absoluteValue_level: int;

DEFINE
	api_telemetry := Telemetry_i(api_telemetry_sequence_number, api_telemetry_valid, api_telemetry_operating_state, api_telemetry_values);

FTSPEC
	-- An untyped incoming event port
	input_event: api_pulse_nonEmpty;
	-- A typed incoming event-data port and its payload
	input_event_data: api_sample_nonEmpty ->
	    (api_sample >= 0);
	-- An incoming integer data port
	input_data: api_level >= 0;
	base_type_boolean: api_boolean_value == true;
	base_type_character: api_character_value == 65;
	base_type_integer_8: api_signed_8_value >= 0;
	base_type_integer_16: api_signed_16_value >= 0;
	base_type_integer_32: api_level >= 0;
	base_type_unsigned_8: api_unsigned_8_value >= 0;
	base_type_unsigned_16: api_unsigned_16_value >= 0;
	-- A Boolean event-data payload
	bool_signal: api_flag_nonEmpty -> api_flag;
	-- An outgoing event must be emitted
	output_event_must_send: api_ack_nonEmpty;
	-- An outgoing event-data port must be emitted
	output_event_data_must_send: api_echo_nonEmpty;
	-- An outgoing event must not be emitted
	output_event_no_send: api_ack_isEmpty;
	-- An outgoing event-data port must not be emitted
	output_event_data_no_send: api_echo_isEmpty;
	-- An outgoing event-data port must carry the expected value
	output_event_data_must_send_value: api_echo_nonEmpty &&
	    (api_echo == 1);
	-- An outgoing data port used as a signal
	output_data: api_healthy == true;
	temporal_future: F[0,3](api_pulse_nonEmpty);
	temporal_eventually: F[0,3](api_sample_nonEmpty);
	temporal_globally: G[0,3](api_level >= 0);
	temporal_until: (api_level >= 0 U[0,5] api_pulse_nonEmpty);
	temporal_release: (api_level >= 0 R[0,5] api_pulse_nonEmpty);
	comparison_operators: (api_level == api_level) &
	    (api_level != -1) &
	    (api_level < 1000) &
	    (api_level <= 1000) &
	    (api_level > -1000) &
	    (api_level >= -1000);
	arithmetic_operators: (api_level + 1 - 1 == api_level) &
	    (api_level * 2 / 2 == api_level) &
	    (api_level % 2 >= 0);
	bitwise_operators: ((api_level & 1) >= 0) &
	    ((api_level | 1) >= api_level) &
	    ((api_level ^ 1) >= 0);
	boolean_operators: !(false) &&
	    (api_pulse_nonEmpty || api_sample_nonEmpty) ->
	    api_pulse_nonEmpty | api_sample_nonEmpty;
	implication_operator: (api_level >= 0) ->
	    (api_level + 1 > 0);
	enum_signal: api_operating_state_nonEmpty ->
	    (api_operating_state != Fault);
	array_signal: api_samples_nonEmpty ->
	    (api_samples_size == 4) &
	      (api_samples[0] >= 0);
	record_signal: api_telemetry_nonEmpty ->
	    (api_telemetry.sequence_number >= 0) &
	      api_telemetry.valid &
	      (api_telemetry.operating_state != Fault) &
	      (api_telemetry.values[0] >= 0);
	conditional_boolean: (((api_level >= 0) && (api_telemetry.sequence_number >= 0)) || (!(api_level >= 0) && (api_telemetry.sequence_number >= 5)));
	quantified_all_until: api_samples_nonEmpty -> foreach(i:api_samples)(i >= 0);
	quantified_all_to: api_samples_nonEmpty -> foreach(i:api_samples)(i >= 0);
	quantified_exists_until: api_samples_nonEmpty -> forsome(i:api_samples)(i == 0);
	quantified_exists_to: api_samples_nonEmpty -> forsome(i:api_samples)(i == 0);
	quantified_slice: api_samples_nonEmpty -> foreach(i:api_samples[1..2])(i >= 0);
	quantified_index_sensitive: api_samples_nonEmpty -> foreach(i_result_0:{api_samples[0] <= api_samples[1],api_samples[1] <= api_samples[2],api_samples[2] <= api_samples[3]})(i_result_0);
	quantified_nested: api_samples_nonEmpty -> foreach(i:api_samples)(forsome(j:api_samples)(i <= j));
	state_variable: sprevious_level <= api_level;
	state_variable_in: in_sprevious_level == sprevious_level;
	boolean_function: fn_isNonNegative_level;
	value_function: fn_absoluteValue_level >= 0;

PTSPEC
	temporal_once: O[0,3](api_pulse_nonEmpty);
	temporal_historically: H[0,3](api_level >= 0);
	temporal_since: (api_level >= 0 S[0,5] api_pulse_nonEmpty);
	temporal_trigger: (api_level >= 0 T[0,5] api_pulse_nonEmpty);


