-- Do not edit this file as it will be overwritten if HAMR codegen is rerun
INPUT
	api_sent_sample_nonEmpty: bool;
	api_observed_sample_nonEmpty: bool;
	api_observed_sample: int;
	api_sent_sample: int;


FTSPEC
	-- The consumer matches every produced sample until the producer pauses, which must occur within five dispatches
	samples_match_until_producer_pauses: (api_sent_sample_nonEmpty & api_observed_sample_nonEmpty &
	    (api_observed_sample == api_sent_sample) U[0,5] !api_sent_sample_nonEmpty);


