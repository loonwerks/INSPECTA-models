# Do not edit this file as it will be overwritten if HAMR codegen is rerun

SDDF ?= $(LIONSOS)/dep/sddf
override SDDF := $(abspath $(SDDF))
ifeq ("$(wildcard $(SDDF)/util/util.mk)","")
$(error Set SDDF to a copy of https://github.com/au-ts/sddf, or LIONSOS to a checkout that vendors it at dep/sddf)
endif


# Metaprogram that generates the system description file.
# Override to use an alternative schedule (e.g. monitor.mk).
MSD ?= $(TOP_DIR)/meta.py

# Header files containing config structs whose sizes the sdfgen helper
# needs to calculate. Override to point at a different config header.
SCHEDULER_CONFIG_HEADERS ?= $(TOP_DIR)/scheduler/include/default.user_config.h

# Scheduler C source file compiled into scheduler.elf.
# Override to substitute a different scheduler implementation
# (e.g. one that publishes schedule state for runtime monitoring).
SCHEDULER_C ?= $(TOP_DIR)/scheduler/src/default.scheduler.c


TOOLCHAIN := clang
CC := clang
LD := ld.lld
RANLIB := llvm-ranlib
AR := llvm-ar
OBJCOPY := llvm-objcopy
MICROKIT_TOOL ?= $(MICROKIT_SDK)/bin/microkit
DTC := dtc
PYTHON ?= python3

SYSTEM_FILE := arinc_scheduling.system
IMAGE_FILE := loader.img
REPORT_FILE := report.txt

SUPPORTED_BOARDS := qemu_virt_aarch64

include ${SDDF}/tools/make/board/common.mk

SDFGEN_HELPER := $(TOP_DIR)/sdfgen_helper.py

# Macros needed by sdfgen helper to calculate config struct sizes
SDFGEN_UNKOWN_MACROS := MAX_PARTITIONS=61 MAX_SCHEDULE_SLOTS=128

SDDF_CUSTOM_LIBC := 1

LDFLAGS := -L$(BOARD_DIR)/lib -L$(SDDF)/lib
LIBS := -lmicrokit -Tmicrokit.ld libsddf_util_debug.a

SDDF_MAKEFILES := ${SDDF}/util/util.mk \
	${SDDF}/drivers/timer/${TIMER_DRIV_DIR}/timer_driver.mk \
	${SDDF}/drivers/serial/${UART_DRIV_DIR}/serial_driver.mk \
	${SDDF}/serial/components/serial_components.mk

include ${SDDF_MAKEFILES}

# exporting TOP_TYPES_INCLUDE in case other makefiles need it
export TOP_TYPES_INCLUDE = -I$(TOP_DIR)/types/include

CFLAGS += \
	-I$(SDDF)/include \
	-I$(SDDF)/include/microkit \
	-I$(TOP_DIR)/scheduler/include \
	$(TOP_TYPES_INCLUDE) \
	-I$(TOP_DIR)/components/A_sub_a/include \
	-I$(TOP_DIR)/components/top_sub_A_sub_a/include \
	-I$(TOP_DIR)/components/top_sub_B_sub_b/include \
	-I$(TOP_DIR)/components/top_sub_C_sub_c/include


UTIL_OBJS :=

TYPE_OBJS := \
	sb_queue_int32_t_1.o


all: cache.o

# Sentinel file whose name encodes a hash of build-affecting variables.
# When any of these change the old sentinel is removed and a new one is created,
# forcing dependent targets to rebuild.
CHECK_FLAGS_BOARD_MD5:=.board_cflags-$(shell echo -- ${CFLAGS} ${BOARD} ${MICROKIT_CONFIG} ${MICROKIT_SDK} ${MSD} ${SCHEDULER_C} ${SCHEDULER_CONFIG_HEADERS}| shasum | sed 's/ *-//')

${CHECK_FLAGS_BOARD_MD5}:
	-rm -f .board_cflags-*
	touch $@


vpath %.c $(SDDF) \
	$(TOP_DIR)/scheduler/src \
	$(TOP_DIR)/types/src \
	$(TOP_DIR)/components/A_sub_a/src \
	$(TOP_DIR)/components/top_sub_A_sub_a/src \
	$(TOP_DIR)/components/top_sub_B_sub_b/src \
	$(TOP_DIR)/components/top_sub_C_sub_c/src


IMAGES := timer_driver.elf scheduler.elf \
	A_sub_a.elf \
	A_sub_a_MON.elf \
	top_sub_A_sub_a.elf \
	top_sub_A_sub_a_MON.elf \
	top_sub_B_sub_b.elf \
	top_sub_B_sub_b_MON.elf \
	top_sub_C_sub_c.elf \
	top_sub_C_sub_c_MON.elf

${IMAGES}: libsddf_util_debug.a ${CHECK_FLAGS_BOARD_MD5}


# user code
A_sub_a_rust:
	make -C ${CRATES_DIR}/A_sub_a $(RUST_MAKE_TARGET)

# user code
top_sub_A_sub_a_rust:
	make -C ${CRATES_DIR}/top_sub_A_sub_a $(RUST_MAKE_TARGET)

# user code
top_sub_B_sub_b_rust:
	make -C ${CRATES_DIR}/top_sub_B_sub_b $(RUST_MAKE_TARGET)

# user code
top_sub_C_sub_c_rust:
	make -C ${CRATES_DIR}/top_sub_C_sub_c $(RUST_MAKE_TARGET)

%.o: %.c ${SDDF}/include
	${CC} ${CFLAGS} -c -o $@ $<

SCHEDULER_OBJ := $(notdir $(basename $(SCHEDULER_C))).o

$(SCHEDULER_OBJ): $(SCHEDULER_C) ${SDDF}/include
	${CC} ${CFLAGS} -c -o $@ $<

scheduler.elf: $(UTIL_OBJS) $(TYPE_OBJS) $(SCHEDULER_OBJ) ${CHECK_FLAGS_BOARD_MD5}
	$(LD) $(LDFLAGS) $(filter %.o, $^) $(LIBS) -o $@

A_sub_a_MON.elf: A_sub_a_MON_user.o A_sub_a_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

A_sub_a.elf: $(UTIL_OBJS) $(TYPE_OBJS) A_sub_a_rust A_sub_a.o
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/A_sub_a/target/aarch64-unknown-none/release $(filter %.o, $^) $(LIBS) -lA_sub_a -o $@

top_sub_A_sub_a_MON.elf: top_sub_A_sub_a_MON_user.o top_sub_A_sub_a_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

top_sub_A_sub_a.elf: $(UTIL_OBJS) $(TYPE_OBJS) top_sub_A_sub_a_rust top_sub_A_sub_a.o
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/top_sub_A_sub_a/target/aarch64-unknown-none/release $(filter %.o, $^) $(LIBS) -ltop_sub_A_sub_a -o $@

top_sub_B_sub_b_MON.elf: top_sub_B_sub_b_MON_user.o top_sub_B_sub_b_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

top_sub_B_sub_b.elf: $(UTIL_OBJS) $(TYPE_OBJS) top_sub_B_sub_b_rust top_sub_B_sub_b.o
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/top_sub_B_sub_b/target/aarch64-unknown-none/release $(filter %.o, $^) $(LIBS) -ltop_sub_B_sub_b -o $@

top_sub_C_sub_c_MON.elf: top_sub_C_sub_c_MON_user.o top_sub_C_sub_c_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

top_sub_C_sub_c.elf: $(UTIL_OBJS) $(TYPE_OBJS) top_sub_C_sub_c_rust top_sub_C_sub_c.o
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/top_sub_C_sub_c/target/aarch64-unknown-none/release $(filter %.o, $^) $(LIBS) -ltop_sub_C_sub_c -o $@



$(SYSTEM_FILE): $(IMAGES) $(DTB) ${CHECK_FLAGS_BOARD_MD5}
	$(PYTHON) $(SDFGEN_HELPER) --macros "$(SDFGEN_UNKOWN_MACROS)" --configs "$(SCHEDULER_CONFIG_HEADERS)" --output $(TOP_BUILD_DIR)/config_structs.py
	$(PYTHON) $(MSD) --sddf $(SDDF) --board $(MICROKIT_BOARD) --dtb $(DTB) --output . --sdf $(SYSTEM_FILE) --objcopy $(OBJCOPY)
	$(OBJCOPY) --update-section .device_resources=timer_driver_device_resources.data timer_driver.elf
	$(OBJCOPY) --update-section .timer_client_config=timer_client_scheduler.data scheduler.elf

$(IMAGE_FILE) $(REPORT_FILE): $(IMAGES) $(SYSTEM_FILE)
	$(MICROKIT_TOOL) $(SYSTEM_FILE) --search-path $(TOP_BUILD_DIR) --board $(MICROKIT_BOARD) --config $(MICROKIT_CONFIG) -o $(IMAGE_FILE) -r $(REPORT_FILE)


FORCE:

qemu:
	$(QEMU) -nographic $(QEMU_ARCH_ARGS)

clean::
	${RM} -f *.elf .depend* $
	find . -name \*.[do] |xargs --no-run-if-empty rm

clobber:: clean
	rm -f *.a
	rm -f ${IMAGE_FILE} ${REPORT_FILE}

test:: 
	make -C ${CRATES_DIR}/A_sub_a test
	make -C ${CRATES_DIR}/top_sub_A_sub_a test
	make -C ${CRATES_DIR}/top_sub_B_sub_b test
	make -C ${CRATES_DIR}/top_sub_C_sub_c test

clean:: 
	make -C ${CRATES_DIR}/A_sub_a clean
	make -C ${CRATES_DIR}/top_sub_A_sub_a clean
	make -C ${CRATES_DIR}/top_sub_B_sub_b clean
	make -C ${CRATES_DIR}/top_sub_C_sub_c clean

verus: 
	make -C ${CRATES_DIR}/A_sub_a verus
	make -C ${CRATES_DIR}/top_sub_A_sub_a verus
	make -C ${CRATES_DIR}/top_sub_B_sub_b verus
	make -C ${CRATES_DIR}/top_sub_C_sub_c verus

verus-sys-proof: 
	make -C ${CRATES_DIR}/sys_above_top_contracts_proof all
