::/*#! 2> /dev/null                                 #
@ 2>/dev/null # 2>nul & echo off & goto BOF         #
if [ -z ${SIREUM_HOME} ]; then                      #
  echo "Please set SIREUM_HOME env var"             #
  exit -1                                           #
fi                                                  #
exec ${SIREUM_HOME}/bin/sireum slang run "$0" "$@"  #
:BOF
setlocal
if not defined SIREUM_HOME (
  echo Please set SIREUM_HOME env var
  exit /B -1
)
%SIREUM_HOME%\bin\sireum.bat slang run "%0" %*
exit /B %errorlevel%
::!#*/
// #Sireum

// Do not edit this file as it will be overwritten if HAMR codegen is rerun

import org.sireum._

// Runs the system tests under QEMU and turns the serial output into an exit code.
//
// Usage:  run-tests.cmd [--list] [<test filter>]
//
// --list builds an image that prints the test table and runs nothing (LIST_TESTS=1).
//
// QEMU_TIMEOUT=<seconds> sets the bound on the QEMU run (default 300).  A suite that
// needs longer than the bound -- about one hyperperiod per frame period -- can raise it,
// or be run as several filtered runs.
//
// RUN_TESTS_TARGET_CMD is for HAMR's own tests of this script: a shell command run in
// place of building the image and booting it under QEMU, whose output stands in for
// the serial console.  It lets those tests drive the stop condition and the verdict
// below with crafted output, without an SDK or QEMU.
//
// The filter is a substring match against the qualified suite::test name, so
// "nominal::" selects a suite and "fan_turns" selects a single test.

val microkitDir: Os.Path = Os.slashDir.up
val listOnly: B = Os.cliArgs.nonEmpty && Os.cliArgs(0) == "--list"
val filterArgs: ISZ[String] = if (listOnly) ops.ISZOps(Os.cliArgs).drop(1) else Os.cliArgs
val filter: String = if (filterArgs.nonEmpty) filterArgs(0) else ""
val listArg: String = if (listOnly) "LIST_TESTS=1" else "LIST_TESTS=0"

// The property tests' seed: PROPTEST_SEED if set, else a fresh one each run, so every
// run explores new cases.  It is printed below and in the property tests' own lines;
// passing it back as PROPTEST_SEED reproduces the run.
val seed: String = Os.env("PROPTEST_SEED") match {
  case Some(s) => s
  case _ =>
    ops.StringOps(Os.proc(ISZ[String]("sh", "-c", "od -An -N32 -tx1 /dev/urandom | tr -dc 0-9a-f")).run().out).trim
}

// make expands a `$` in a variable's value, in the rebuild hash and in what it hands the
// build, and the hash is echoed, which reads `\`: a filter holding either would select
// something other than what was typed.  No test name can contain them.
if (ops.StringOps(filter).contains("$") || ops.StringOps(filter).contains("\\")) {
  eprintln(s"FAILED: a test filter cannot contain '$$' or '\\' (got '$filter')")
  Os.exit(1)
}

// sddf_dprintf is compiled out unless CONFIG_DEBUG_BUILD is set, which would remove
// every TEST line and make a perfectly good run look like a failure.  Force it.
val commonArgs: ISZ[String] = ISZ(
  "make", "-C", microkitDir.string,
  "CONFIG=test_scheduler.mk",
  "MICROKIT_CONFIG=debug",
  "RUST_MAKE_TARGET=build-release",
  s"TESTS=$filter",
  listArg,
  s"PROPTEST_SEED=$seed")

val qemuTimeout: Z = Os.env("QEMU_TIMEOUT") match {
  case Some(t) =>
    Z(ops.StringOps(t).trim) match {
      case Some(n) if n > 0 => n
      case _ =>
        eprintln(s"FAILED: QEMU_TIMEOUT must be a positive number of seconds (got '$t')")
        Os.exit(1)
        halt("unreachable")
    }
  case _ => 300
}

val targetCmd: Option[String] = Os.env("RUN_TESTS_TARGET_CMD")
if (targetCmd.isEmpty) {
  println(s"Building $microkitDir (TESTS='$filter', $listArg, PROPTEST_SEED=$seed) ...")
  val build = Os.proc(commonArgs).console.run()
  if (!build.ok) {
    eprintln("Build failed")
    Os.exit(1)
  }
  println(s"Running under QEMU (bound $qemuTimeout s) ...")
} else {
  println(s"Running RUN_TESTS_TARGET_CMD in place of the build and QEMU: ${targetCmd.get}")
}

// QEMU never exits on its own: once the suite is done the scheduler idles and the
// guest goes quiet.  Waiting for the timeout would make every successful run cost
// the full bound, so watch the log and stop QEMU as soon as DONE appears.  Piping
// into `sed /DONE/q` does not work here -- with the guest idle there is no further
// write to raise SIGPIPE -- so the process group has to be killed explicitly.  The
// console writes a line a character at a time, so DONE can be seen before the rest of
// its line is out: QEMU is given another second before it is stopped.  DONE counts only
// at the start of a line, as it does for the verdict below: a test's own message that
// mentions it must not stop the run before the real one.  Two failures
// end the run early too, since nothing after them can reach DONE: a protection domain
// that faults or panics before the schedule starts (it never reports ready, so the
// test scheduler never hands over), and a panic in the test controller itself.  A
// thread that faults or panics once the schedule runs is not one of them: its dispatch
// trips the watchdog, which fails the test, and the run goes on to DONE.  Reaching the
// bound exits 124, so the verdict can say so.
val logFile: Os.Path = Os.temp()

val driver: String =
  st"""set -u
      |"$$@" > "$$LOG" 2>&1 &
      |mpid=$$!
      |waited=0
      |bound=0
      |while kill -0 $$mpid 2>/dev/null; do
      |  grep -q '^TEST | DONE' "$$LOG" && { sleep 1; break; }
      |  if ! grep -q 'All partitions ready' "$$LOG" && grep -q -e 'FAULT in user PD' -e 'PANIC' "$$LOG"; then sleep 1; break; fi
      |  grep -q 'test_controller.*PANIC' "$$LOG" && { sleep 1; break; }
      |  [ $$waited -ge $$TIMEOUT ] && { bound=1; break; }
      |  sleep 1
      |  waited=$$((waited + 1))
      |done
      |pkill -P $$mpid 2>/dev/null
      |kill $$mpid 2>/dev/null
      |wait $$mpid 2>/dev/null
      |[ $$bound -eq 1 ] && exit 124
      |exit 0""".render

val target: ISZ[String] = targetCmd match {
  case Some(c) => ISZ[String]("sh", "-c", c)
  case _ => commonArgs :+ "qemu"
}
val reachedBound: B = Os.proc(ISZ[String]("sh", "-c", driver, "sh") ++ target)
  .env(ISZ(("LOG", logFile.string), ("TIMEOUT", qemuTimeout.string)))
  .timeout((qemuTimeout + 30) * 1000).run().exitCode == 124

val out: String = if (logFile.exists) logFile.read else ""
logFile.removeAll()

var matched: Z = -1
var passed: Z = -1
var failed: Z = -1
// an initialization guarantee is taken as met only on DONE's own word (init=ok): a
// DONE line cut short must not pass a run whose initialization failed
var initOk: B = F
var listed: B = F
var sawDone: B = F
var seenPass: Z = 0
var seenFail: Z = 0
var seenListed: Z = 0

// The QEMU serial console emits CRLF, so every line arrives with a trailing \r.
// Left in place it makes Z("0\r") a None and the parse below blows up.
val normalized: String = ops.StringOps(out).replaceAllLiterally("\r", "")

for (line <- ops.StringOps(normalized).split((c: C) => c == '\n')) {
  val l = ops.StringOps(line)
  if (l.startsWith("TEST | ")) {
    println(line)
    if (l.startsWith("TEST | PASS")) {
      seenPass = seenPass + 1
    } else if (l.startsWith("TEST | FAIL")) {
      seenFail = seenFail + 1
    } else if (l.startsWith("TEST | LIST") && !l.endsWith("(not selected)")) {
      seenListed = seenListed + 1
    } else if (l.startsWith("TEST | DONE")) {
      sawDone = T
      for (tok <- ops.StringOps(line).split((c: C) => c == ' ')) {
        val t = ops.StringOps(tok)
        if (t.startsWith("matched=")) {
          matched = Z(t.substring(8, tok.size)).getOrElse(-1)
        } else if (t.startsWith("passed=")) {
          passed = Z(t.substring(7, tok.size)).getOrElse(-1)
        } else if (t.startsWith("failed=")) {
          failed = Z(t.substring(7, tok.size)).getOrElse(-1)
        } else if (t.startsWith("init=")) {
          initOk = t.substring(5, tok.size) == "ok"
        } else if (t.startsWith("list=")) {
          listed = t.substring(5, tok.size) == "1"
        }
      }
    }
  }
}

// Absence of evidence is failure.  A hang, a panicking protection domain, or a
// controller that never ran all produce a well-formed-looking log with no DONE.
if (!sawDone) {
  val stops = ops.StringOps(normalized).split((c: C) => c == '\n').filter((l: String) =>
    ops.StringOps(l).contains("FAULT in user PD") || ops.StringOps(l).contains("PANIC"))
  if (stops.nonEmpty) {
    eprintln("FAILED: a protection domain faulted or panicked, and the run produced no 'TEST | DONE' line:")
    for (l <- stops) {
      eprintln(s"  $l")
    }
  }
  if (reachedBound) {
    eprintln(s"FAILED: the QEMU bound of $qemuTimeout s was reached before 'TEST | DONE' (a hang, or a suite longer than the bound: raise QEMU_TIMEOUT or split the suite with a filter)")
  } else {
    eprintln("FAILED: the run produced no 'TEST | DONE' line (hang, panic, or the test controller never ran)")
  }
  eprintln("---- captured output ----")
  eprintln(out)
  Os.exit(1)
}

// A DONE line cut short before its counts: output was lost, whatever the filter was.
if (matched < 0 || passed < 0 || failed < 0) {
  eprintln("FAILED: the 'TEST | DONE' line is incomplete (matched=, passed= or failed= missing); output was lost")
  Os.exit(1)
}

// A filter that selects nothing must not pass: that is how a typo turns a job green.
if (matched == 0) {
  eprintln(s"FAILED: the filter '$filter' matched no tests")
  Os.exit(1)
}

// What was asked for and what the image did have to agree.  LIST_TESTS is part of the
// build's rebuild hash, so a listing image should never be reused for a run -- but if
// one were, its list=1 verdict would pass having run nothing, so it is checked.
if (listed != listOnly) {
  if (listed) {
    eprintln("FAILED: the image only listed the tests (DONE list=1), but a run was requested; nothing was run")
  } else {
    eprintln("FAILED: --list was requested, but the image ran the tests (DONE has no list=1)")
  }
  Os.exit(1)
}

// A listing runs nothing; the table above is its output.  It still has to be a listing:
// nothing run, every selected test in the table, and initialization intact -- a broken
// initialization guarantee is a fault in the system whether or not tests then run.
if (listed) {
  if (passed != 0 || failed != 0 || seenPass != 0 || seenFail != 0) {
    eprintln(s"FAILED: a listing reports tests as run (passed=$passed failed=$failed, $seenPass PASS and $seenFail FAIL lines)")
    Os.exit(1)
  }
  if (seenListed != matched) {
    eprintln(s"FAILED: DONE reports matched=$matched but the table lists $seenListed selected test(s); output was lost")
    Os.exit(1)
  }
  if (!initOk) {
    eprintln("FAILED: an initialization guarantee was violated, or DONE's init= was lost (DONE init=failed or missing)")
    Os.exit(1)
  }
  println(s"OK: listed $matched test(s) matching '$filter'; none were run")
  Os.exit(0)
}

// The counts and the per-test lines have to agree, or output was lost -- and every
// matched test was run, or DONE was cut short (a listing's list=1 among what was lost).
if (passed != seenPass || failed != seenFail || passed + failed != matched) {
  eprintln(s"FAILED: DONE reports matched=$matched passed=$passed failed=$failed but $seenPass PASS and $seenFail FAIL lines were seen; output was lost")
  Os.exit(1)
}

if (failed != 0) {
  eprintln(s"FAILED: $failed of $matched tests failed")
  Os.exit(1)
}

// An initialization guarantee was violated before any test ran (see the VIOLATION
// lines above).  No test is charged with it, so it has to fail the run here.
if (!initOk) {
  eprintln("FAILED: an initialization guarantee was violated, or DONE's init= was lost (DONE init=failed or missing)")
  Os.exit(1)
}

println(s"OK: $passed of $matched tests passed")
Os.exit(0)
