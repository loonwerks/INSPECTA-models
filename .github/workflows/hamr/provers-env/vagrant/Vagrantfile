# -*- mode: ruby -*-
# vi: set ft=ruby :

# Vagrant/VirtualBox VM for the DARPA PROVERS development environment.
#
# The provisioning mirrors
#   .github/workflows/hamr/provers-env/docker/Dockerfile.provers
#
# Knobs (set as environment variables before running vagrant/setup.sh):
#
#   PROVERS_CPUS      number of vCPUs                    (default 4)
#   PROVERS_MEMORY    RAM in MB                          (default 8192)
#   PROVERS_VRAM      video RAM in MB                    (default 64)
#   PROVERS_DESKTOP   install the XFCE desktop           (default true)
#   PROVERS_ARCH      box architecture, amd64 or arm64   (default: the host's)
#   PROVERS_SYNCED_FOLDER  mount /vagrant on arm64           (default false;
#                     needs Guest Additions, which the build installs)
#   PROVERS_VM_NAME   VirtualBox machine name            (default:
#                     provers-env-<arch>-<PROVERS_BUILD_VER>)
#   PROVERS_BUILD_VER the version this build carries     (default: the pin in
#                     bin/versions.sh; also names the OVA and the image tags)
#   PROVERS_IVE       install the Sireum IVE             (default true)
#   PROVERS_CODEIVE   install CodeIVE                    (default true)
#   PROVERS_FMIDE     install FMIDE                      (default true)
#   FIRST_RUN         set by setup.sh, skips vbguest     (default unset)
#
#   PROVERS_APT_MIRROR           alternative Ubuntu mirror, e.g.
#                                https://mirrors.kernel.org/ubuntu/
#                                (default unset: Canonical's archives)
#   PROVERS_APT_SECURITY_MIRROR  mirror for -security  (default: the above)
#
# Tool versions are pinned in bin/versions.sh; SIREUM_V (kekinian branch/tag/SHA)
# and FMIDE_ARGS are forwarded into the VM as well.
#
# The VM ships an X11 desktop because it installs the IVE, CodeIVE and FMIDE
# GUIs; 16384 MB is a more comfortable PROVERS_MEMORY if you intend to run them.

# vagrant-vbguest 0.32.0 calls File.exists? in guess_local_iso
# (lib/vagrant-vbguest/hosts/virtualbox.rb:84).  Ruby removed that alias, so on
# the Ruby 3.3 that Vagrant 2.4.9 embeds it raises NoMethodError and takes
# 'vagrant up --provision' down with it -- the second up in setup.sh, which is
# the one where vbguest is not suppressed by FIRST_RUN.  A fresh x86_64 build
# cannot get past it.  The same file calls File.exist? ten lines earlier, so
# this is a straggler rather than a deliberate API choice.
#
# Vagrant evaluates this file before the plugin's action runs, so restoring the
# alias here is enough, and the guard means it disappears on its own once the
# plugin is fixed or Ruby brings the method back.
File.singleton_class.alias_method(:exists?, :exist?) unless File.respond_to?(:exists?)

Vagrant.configure("2") do |config|

  required_plugins = %w( vagrant-vbguest )
  _retry = false
  required_plugins.each do |plugin|
    unless Vagrant.has_plugin? plugin
      system "vagrant plugin install #{plugin}"
      _retry=true
    end
  end

  if (_retry)
    exec "vagrant " + ARGV.join(' ')
  end

  desktop = ENV.fetch('PROVERS_DESKTOP', 'true') == 'true'

  # Which box architecture to bring up.  bento/ubuntu-24.04 publishes both, and
  # Vagrant 2.4 picks by host architecture on its own, but naming it keeps a
  # build reproducible rather than dependent on where it was run.  Note that
  # VirtualBox virtualizes only its host's architecture -- an x86 guest on an
  # Apple Silicon host fails to launch with VBOX_E_PLATFORM_ARCH_NOT_SUPPORTED,
  # and vice versa -- so this follows the host unless deliberately overridden.
  host_arch = (RbConfig::CONFIG['host_cpu'] =~ /arm|aarch64/i) ? 'arm64' : 'amd64'
  arch = ENV.fetch('PROVERS_ARCH', host_arch)

  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_architecture = arch
  # Pinned so rebuilds get the same base image: left unpinned, a rebuild months
  # from now silently picks up whatever bento has published since, which can
  # move the kernel and the package set under an otherwise unchanged recipe.
  # Bump deliberately after checking the build still passes.
  config.vm.box_version = "202510.26.0"   # Ubuntu 24.04.4 LTS, kernel 6.8.0-137

  config.vm.hostname = "provers"

  # The VM name carries the architecture and the build version.  Both matter now
  # that there are two architectures: a plain "provers-env" collides as soon as
  # you build the second one, or rebuild while an older VM is still registered,
  # and VirtualBox refuses to create a duplicate name.  It also means the name
  # alone tells you what a registered VM is, which the OVA inherits.
  #
  # The version is PROVERS_BUILD_VER from bin/versions.sh -- read out of that file
  # rather than restated here, so the VM, the OVA and the container image built
  # from one set of pins all carry one version.  It used to be the host clock's
  # date, which drifted: this file is evaluated per vagrant command and Vagrant
  # re-applies vb.name on every 'up', so a VM built one evening was silently
  # renamed by the next morning's 'vagrant up'.  Vagrant itself does not care,
  # since it tracks the machine by id, but anything naming the VM does --
  # 'VBoxManage snapshot <name>' stops resolving.  A pin cannot drift.  The clock
  # remains only as a fallback, for a bin/ that predates the pin.
  #
  # PROVERS_VM_NAME still overrides outright.  And prep-export.sh derives the
  # appliance name from build-info rather than from the VM's name, passing it as
  # --vmname, so the OVA is correct regardless of what the machine is called.
  versions_sh = File.expand_path('../bin/versions.sh', __dir__)
  pinned_build_ver =
    if File.exist?(versions_sh)
      File.read(versions_sh)[/^:\s*"\$\{PROVERS_BUILD_VER:=([^}]*)\}"/, 1]
    end
  build_ver = ENV['PROVERS_BUILD_VER'] || pinned_build_ver ||
              Time.now.strftime('%Y.%m.%d')

  vm_name = ENV.fetch('PROVERS_VM_NAME', "provers-env-#{arch}-#{build_ver}")

  # VirtualBox ships the Guest Additions image with the application.  aarch64
  # needs it copied into the guest (see the provisioners below); where it lives
  # depends on the host, and PROVERS_GA_ISO overrides the search.
  ga_iso = ENV['PROVERS_GA_ISO'] || [
    '/Applications/VirtualBox.app/Contents/MacOS/VBoxGuestAdditions.iso',
    '/usr/share/virtualbox/VBoxGuestAdditions.iso',
    '/usr/lib/virtualbox/additions/VBoxGuestAdditions.iso',
    'C:/Program Files/Oracle/VirtualBox/VBoxGuestAdditions.iso',
  ].find { |f| File.exist?(f) }
  if arch == 'arm64' && ga_iso.nil?
    puts 'provers-env: no Guest Additions ISO found on the host; clipboard,'
    puts '             drag-and-drop and guest resizing will be unavailable.'
    puts '             Set PROVERS_GA_ISO to point at VBoxGuestAdditions.iso.'
  end


  config.vm.provider :virtualbox do |vb|
    vb.name = vm_name
    vb.cpus = Integer(ENV.fetch('PROVERS_CPUS', '4'))
    vb.memory = Integer(ENV.fetch('PROVERS_MEMORY', '8192'))
    vb.gui = desktop
    vb.linked_clone = false
    vb.customize ["modifyvm", :id, "--vram", ENV.fetch('PROVERS_VRAM', '64')]
    vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
    vb.customize ["modifyvm", :id, "--draganddrop", "bidirectional"]
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
    if arch == 'amd64'
      # Nested paging and large pages help the Microkit SDK and Rust builds, but
      # they are x86-only knobs: VirtualBox 7.2 moved that family behind an
      # --x86- prefix and rejects these outright for an ARM machine, with
      # "error: Invalid option case 1176".  Vagrant treats a failing customize
      # as fatal, so they have to be skipped rather than left to fail.
      vb.customize ["modifyvm", :id, "--nested-paging", "on"]
      vb.customize ["modifyvm", :id, "--large-pages", "on"]
    end
  end

  # vagrant-vbguest runs the Guest Additions installer as
  #   yes | /mnt/VBoxLinuxAdditions.run --nox11
  # (vagrant-vbguest/installers/linux.rb, whose :yes option defaults to true).
  # The installer starts vboxadd-service, which inherits the read end of that
  # pipe, so when the installer exits 'yes' is never sent SIGPIPE -- it blocks
  # on write forever.  Vagrant then never sees the SSH channel close and
  # 'vagrant up --provision' hangs *after* the additions installed successfully,
  # before reaching the file provisioners.  The --nox11 installer is
  # non-interactive, so drop the 'yes' feed rather than the additions update.
  # This bites whenever the box's additions lag the host's VirtualBox.
  config.vbguest.yes = false

  if ENV['FIRST_RUN'] == 'true'
    config.vbguest.auto_update = false
  end

  # vagrant-vbguest (0.32.0) hardcodes the installer name as
  # 'VBoxLinuxAdditions.run' (lib/vagrant-vbguest/installers/linux.rb), with no
  # architecture selection.  The Guest Additions ISO carries both that and
  # 'VBoxLinuxAdditions-arm64.run', so on an ARM guest the plugin would run the
  # x86 installer.  The bento arm64 box ships additions of its own, so leave them
  # alone rather than let the plugin replace them with the wrong build.  If the
  # /vagrant shared folder misbehaves after a VirtualBox upgrade, install them by
  # hand from the mounted ISO with the -arm64 installer.
  if arch == 'arm64'
    config.vbguest.auto_update = false

    # ...and the box's own additions do not provide vboxsf for this VirtualBox,
    # so the /vagrant share cannot mount: 'mount -t vboxsf' fails with "No such
    # device" and takes 'vagrant up' with it.  Nothing here needs the share --
    # provers-setup.sh and bin/ arrive through file provisioners, which use SSH,
    # and setup.sh pushes apt-mirror.sh with 'vagrant upload' for the same
    # reason -- so disable it rather than block the build on a share no step
    # reads.  Clipboard and drag-and-drop also want additions and will be
    # inactive; the desktop and the IDEs do not care.
    # Vagrant mounts synced folders before provisioners run, so on the build that
    # installs the additions the share still cannot mount -- and a failed mount
    # aborts 'vagrant up'.  It is therefore off by default.  Once a VM has the
    # additions, PROVERS_SYNCED_FOLDER=true turns it back on for later ups.
    unless ENV['PROVERS_SYNCED_FOLDER'] == 'true'
      config.vm.synced_folder '.', '/vagrant', disabled: true
    end
  end

  # The box's disk is 64GB, but Ubuntu's installer formats only ~31GB of it and
  # leaves the rest free in the volume group, which is not enough headroom for
  # the full install.  bin/disk.sh reclaims those extents during provisioning,
  # bringing root to ~62GB.  Only if you need more than the physical 64GB does
  # this become necessary (requires: vagrant plugin install vagrant-disksize):
  # config.disksize.size = '100GB'

  # The bento box ships the kernel command line its own build used:
  #   GRUB_CMDLINE_LINUX_DEFAULT="autoinstall ds=nocloud-net;s=http://10.0.2.2:8648/ubuntu/"
  # 10.0.2.2 is the VirtualBox NAT gateway (the host) and that HTTP server only
  # existed while the box was being built, so every boot carries an autoinstall
  # flag and a cloud-init datasource pointing at nothing.  Harmless but dead, and
  # not something to hand out in an appliance.  Guarded, so it is a no-op once
  # applied and on any box that does not have it.
  config.vm.provision "shell", inline: <<-SHELL
    if grep -q 'autoinstall' /etc/default/grub; then
      echo "Removing the box's leftover autoinstall/cloud-init kernel parameters"
      sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=""|' /etc/default/grub
      update-grub
    fi
  SHELL

  # Build the ARM Guest Additions from the ISO vagrant-vbguest attaches.  The
  # plugin mounts it on every 'up' to compare versions -- that part works on ARM
  # -- and only its *installer* is x86-only, so there is nothing to attach here:
  # the image turns up at VirtIO port 1 on its own.  (Attaching it explicitly
  # does not work anyway: 'storageattach --medium' mounts into an existing drive
  # rather than creating the slot, and a failing customize aborts the up.)
  # Not fatal if it fails:
  # nothing in the build needs them, they buy clipboard, drag-and-drop and guest
  # display resizing, and they are what makes an exported appliance pleasant to
  # use.  build-essential and linux-headers-generic are already installed by
  # setup.sh's first phase, which is what the installer needs to build modules.
  if arch == 'arm64' && ga_iso
    # The ISO is copied in rather than attached as a virtual drive.  Nothing
    # attaches it on a fresh build -- vagrant-vbguest would, but it is disabled
    # here (below), and 'VBoxManage storageattach --medium' mounts into an
    # existing drive rather than creating the slot, so it cannot be added after
    # the box is defined.  A file provisioner plus a loopback mount needs no
    # cooperation from VirtualBox at all.  Named so it can be re-run alone.
    config.vm.provision "additions-iso", type: "file",
                        source: ga_iso, destination: "/tmp/ga.iso"

    # Named so it can be run on its own against an existing VM:
    #   vagrant provision --provision-with additions-iso,guest-additions
    config.vm.provision "guest-additions", type: "shell", inline: <<-SHELL
      if lsmod | grep -q vboxsf; then
        echo "Guest Additions already present"
      elif [ -f /tmp/ga.iso ]; then
        echo "Installing the ARM Guest Additions ..."
        mkdir -p /mnt/ga
        mount -o loop,ro /tmp/ga.iso /mnt/ga
        # --nox11 because no X exists yet: this runs before the desktop is
        # installed, so only the kernel modules can be built.  desktop-additions
        # re-runs the installer afterwards to add the X11 pieces.
        # the installer exits non-zero when it wants a reboot, which is normal
        sh /mnt/ga/VBoxLinuxAdditions-arm64.run --nox11 || true
        umount /mnt/ga
        modprobe vboxsf 2>/dev/null || true
        lsmod | grep -q vboxsf && echo "  vboxsf loaded" \
          || echo "  WARNING: vboxsf still unavailable; /vagrant stays disabled"
      else
        echo "  WARNING: no additions ISO uploaded; skipping"
      fi
    SHELL
  end

  config.vm.provision "file", source: "../provers-setup.sh", destination: "provers-setup.sh"

  config.vm.provision "file", source: "../bin", destination: "bin"

  # forward the pinned tool versions into the VM so that overriding a version on
  # the host is honored during provisioning
  provers_env = {}
  %w( MICROKIT_SDK_VER MICROKIT_DOMAINS_SDK_VER RUST_TOOLCHAIN_VER
      RUST_NIGHTLY_VER SDFGEN_VER VERUS_VER LIONSOS_VER PROVERS_DIR
      SIREUM_V SIREUM_INIT_V FMIDE_ARGS PROVERS_BUILD_VER
      PROVERS_IVE PROVERS_CODEIVE PROVERS_FMIDE
      Z3_VER ZIG_VER ARM_GNU_TOOLCHAIN_VER
      PROVERS_APT_MIRROR PROVERS_APT_SECURITY_MIRROR ).each do |v|
    provers_env[v] = ENV[v] if ENV[v]
  end

  config.vm.provision "shell", privileged: false, env: provers_env, inline: <<-SHELL
    chmod +x $HOME/bin/*.sh $HOME/provers-setup.sh
    bash $HOME/provers-setup.sh || exit 1
    rm -f $HOME/provers-setup.sh
  SHELL

  if desktop
    # Named so it can be run against an existing VM without re-running the whole
    # install:  vagrant provision --provision-with desktop
    config.vm.provision "desktop", type: "shell", inline: <<-SHELL
      export DEBIAN_FRONTEND=noninteractive
      adduser vagrant vboxsf || true
      echo "Installing the XFCE desktop ..."
      apt-get update
      apt-get install -y xfce4 xfce4-terminal xfce4-goodies lightdm
      # Point LightDM at the session that is actually installed.  Left alone it
      # falls back to its built-in default session name, 'ubuntu', which does
      # not exist on this box -- the only entry in /usr/share/xsessions is
      # xfce.desktop.  The symptom is a login that authenticates successfully
      # and then fails with "Failed to start session", with
      # "Can't find session 'ubuntu'" in /var/log/lightdm/lightdm.log.
      mkdir -p /etc/lightdm/lightdm.conf.d
      printf '[Seat:*]\\nuser-session=xfce\\n' > /etc/lightdm/lightdm.conf.d/50-xfce.conf
      systemctl set-default graphical.target
      # XFCE's "Web Browser" launcher runs 'exo-open --launch WebBrowser'.  With
      # no browser installed that fails with an input/output error, and once the
      # resulting "choose a browser" prompt is dismissed it fails *silently*
      # thereafter (WebBrowserDismissed=true lands in the user's helpers.rc).
      # So install a browser and name it as the default image-wide.
      sudo -u vagrant -H bash /home/vagrant/bin/firefox.sh
      mkdir -p /etc/xdg/xfce4
      printf 'WebBrowser=firefox\\n' > /etc/xdg/xfce4/helpers.rc
      # Once the desktop is installed, shutdown deadlocks: systemd never
      # finishes the shutdown job transaction, so the VM runs forever instead of
      # powering off.  Captured over a serial console, PID 1 sits in a loop with
      #
      #   basic.target:    stopping held back, waiting for: NetworkManager-wait-online.service
      #   shutdown.target: starting held back, waiting for: basic.target
      #   sysinit.target:  stopping held back, waiting for: lxd-installer.socket
      #
      # It is not the kernel or the hypervisor ('poweroff -ff' halts in 0s) and
      # not systemd-shutdown (that stage is never reached).  Masking whichever
      # unit is named just moves the block to another one -- snapd.socket,
      # run-qemu.mount, systemd-tmpfiles-setup.service -- so the individual
      # units are symptoms, not the cause, which is still unidentified.
      #
      # The deadlock is intermittent -- the same VM sometimes powers off in 5s
      # and sometimes never -- so bound it rather than leave it unbounded: if the
      # job has not completed in 45s, force it.  That is safe because the
      # filesystem work finishes long before the deadlock; checked afterwards,
      # the filesystem came up clean with no journal recovery needed.  45s (not
      # 60) so the guest wins the race against vagrant's own graceful_halt
      # timeout and halts itself, rather than VirtualBox pulling the plug.
      #
      # Set per target, NOT on the shared shutdown.target: a single
      # JobTimeoutAction there applies to reboots too, so 'poweroff-force' turns
      # every reboot into a shutdown -- confirmed, a reboot powered the VM off
      # after 45s.  Each target gets the matching action instead.
      mkdir -p /etc/systemd/system/poweroff.target.d /etc/systemd/system/reboot.target.d
      printf '[Unit]\\nJobTimeoutSec=45\\nJobTimeoutAction=poweroff-force\\n' \\
        > /etc/systemd/system/poweroff.target.d/50-provers-timeout.conf
      printf '[Unit]\\nJobTimeoutSec=45\\nJobTimeoutAction=reboot-force\\n' \\
        > /etc/systemd/system/reboot.target.d/50-provers-timeout.conf
    SHELL

    # Only aarch64 needs this.  On amd64 vagrant-vbguest installs the additions
    # itself, X11 components included, so there is nothing to add -- and running
    # the ARM installer there would be actively wrong: the ISO carries both, so
    # a file-exists test does not distinguish them.
    #
    # On aarch64 the additions went in earlier with --nox11, before any X
    # existed.  Re-running the installer now that the desktop is present adds the
    # display driver and VBoxClient, without which the desktop does not follow
    # the window when it is resized.
    if arch == 'arm64'
      config.vm.provision "desktop-additions", type: "shell", inline: <<-SHELL
        if [ -f /tmp/ga.iso ]; then
          echo "Adding the Guest Additions X11 components ..."
          mkdir -p /mnt/ga
          mount -o loop,ro /tmp/ga.iso /mnt/ga
          sh /mnt/ga/VBoxLinuxAdditions-arm64.run || true
          umount /mnt/ga
          rm -f /tmp/ga.iso
          pgrep -x VBoxDRMClient > /dev/null && echo "  VBoxDRMClient running" \
            || echo "  note: VBoxDRMClient starts on the next boot"
        else
          echo "WARNING: no additions ISO; desktop resizing will not work"
        fi
      SHELL
    end
  end

end
